{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build project",
      "type": "shell",
      "command": "./build",

      "group": {
        "kind": "build",
        "isDefault": true // Делает задачу дефолтной для действия "Build"
      },

      // Вывод нужно анализировать как ошибки Go
      "problemMatcher": ["$go"]
    }
  ]
}
